---
import "../app.css";
import { Font } from "astro:assets";

export interface Props {
	title: string;
}

const { title } = Astro.props;
const faviconUrl = new URL("/poggers.webp", Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width" name="viewport" />
		<link href="/poggers.webp" rel="icon" type="image/png" />
		<meta content={Astro.generator} name="generator" />
		<link href="/manifest.json" rel="manifest" />

		<meta content="Will Nelson" name="og:title" />
		<meta content="Software engineer @ Discord" name="og:description" />
		<meta content={faviconUrl} name="og:image" />
		<meta content={Astro.url} name="og:url" />
		<meta content="profile" name="og:type" />
		<meta content="Will" name="og:profile:first_name" />
		<meta content="Nelson" name="og:profile:last_name" />
		<meta content="appellation" name="og:profile:username" />
		<meta content="male" name="og:profile:gender" />

		<meta content="summary" name="twitter:card" />
		<meta content="@appellation_" name="twitter:site" />

		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" preload />
		<title>{title}</title>
	</head>
	<body
		class="flex h-screen bg-stone-200 dark:bg-stone-800 dark:text-white font-serif"
	>
		<slot />
	</body>
</html>
