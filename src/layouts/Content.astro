---
import "../app.css";
import { Font } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import { postTitle } from "../components/util/content";

export interface Props {
	publishDate: Date;
	subtitle?: string;
	title: string;
}

const { title, subtitle, publishDate } = Astro.props;
const pageTitle = postTitle(Astro.props);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width" name="viewport" />
		<link href="/poggers.webp" rel="icon" type="image/png" />
		<meta content={Astro.generator} name="generator" />
		<link href="/manifest.json" rel="manifest" />

		<meta content={pageTitle} name="og:title" />
		<meta content={Astro.url} name="og:url" />
		<meta content="article" name="og:type" />
		<meta
			content={publishDate.toISOString()}
			name="og:article:published_time"
		/>
		<meta content={Astro.site} name="og:article:author" />

		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" preload />
		<title>{pageTitle} | Will Nelson</title>
	</head>
	<body
		class="flex h-screen bg-stone-200 dark:bg-stone-800 dark:text-white font-serif"
	>
		<div class="container mx-auto w-full px-4">
			<Navbar />
			<article
				class="prose prose-stone dark:prose-invert max-w-prose mx-auto w-full pb-24"
			>
				<header>
					<h1 class={subtitle ? "mb-0" : ""}>{title}</h1>
					{
						subtitle && (
							<p class="mt-0 mb-4 italic text-stone-600 dark:text-stone-400 text-lg">
								{subtitle}
							</p>
						)
					}
				</header>
				<slot />
			</article>
		</div>
	</body>
</html>
